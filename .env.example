# Copy to .env. Never commit .env.
NODE_ENV=development
DATABASE_URL=postgres://osx:osx_dev_password@localhost:5433/opensourcex
LOG_LEVEL=info
# Read-only GitHub token for public data (optional in M0/M1a)
GITHUB_TOKEN=
# Live source fetching. Keep false: GSoC/LFX/CNCF are `pending` (docs/DATA_POLICY.md).
DATA_MODE=recorded
# development = local labeled session only. Real Google/GitHub sign-in is not connected.
AUTH_MODE=development
# Hosted preview only: anonymous per-browser guest sessions until real sign-in exists.
GUEST_PREVIEW=false
INGESTION_LIVE_SOURCES=false
# Ask chat AI (D-021). Off here; when true, providers are tried in order and any without
# a key is skipped. With none, or past the daily caps, Ask answers offline from recorded data.
AI_ENABLED=false
# Free providers, no card needed (tried first): Google AI Studio key and Groq key.
GOOGLE_GENERATIVE_AI_API_KEY=
ASK_GOOGLE_MODEL=gemini-3.5-flash
GROQ_API_KEY=
ASK_GROQ_MODEL=openai/gpt-oss-120b
# Vercel AI Gateway: automatic on Vercel (OIDC). Free credits, but Vercel needs a card on file.
AI_GATEWAY_API_KEY=
ASK_GATEWAY_MODEL=google/gemini-3.1-flash-lite
# Optional paid fallbacks; leave empty to stay free.
ANTHROPIC_API_KEY=
ASK_ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
ASK_OPENAI_MODEL=gpt-5.4-mini
# Optional order, e.g. groq,google,gateway
ASK_PROVIDER_ORDER=
# Free-tier caps: AI answers per user and site-wide in any 24 hours.
ASK_AI_PER_USER_DAY=25
ASK_AI_GLOBAL_DAY=200
